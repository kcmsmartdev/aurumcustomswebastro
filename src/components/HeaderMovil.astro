---
import { Image } from 'astro:assets';
import Logo from "../assets/images/logo-movil.svg";
const props = Astro.props
---

<header class="w-full ">
    <nav class="p-3 flex flex-row justify-between items-center">
       <a href="/">
            <Image src={Logo} alt="Logo Aurum Customs Sac" 
            class="w-32 h-auto sm:w-36 md:w-44" />
        </a>

        <div>
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 16 16" {...props}>
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m2.75 12.25h10.5m-10.5-4h10.5m-10.5-4h10.5" />
            </svg>
        </div>
    </nav>

</header>