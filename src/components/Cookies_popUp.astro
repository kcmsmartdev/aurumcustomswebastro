---

---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 w-full z-50 hidden font-Urbanist"
>
  <div
    class="bg-footer/95 backdrop-blur-md border-t border-blanco/10 px-6 py-6 shadow-2xl"
  >
    <div
      class="max-w-7xl mx-auto flex flex-col md:flex-row gap-6 md:items-center md:justify-between"
    >
      <!-- Texto -->
      <p
        class="text-sm md:text-base leading-relaxed text-blancoClaro max-w-3xl"
      >
        Utilizamos cookies para mejorar tu experiencia, analizar el uso del
        sitio y optimizar nuestros servicios. Al continuar navegando, aceptas
        nuestra
        <a
          href="/politica-de-cookies"
          class="text-primario font-semibold underline underline-offset-4 hover:opacity-80 transition"
        >
          Política de Cookies
        </a>.
      </p>

      <!-- Botones -->
      <div class="flex gap-3 shrink-0">
        <button
          id="btn-rechazar-cookies"
          class="px-5 py-2 rounded-xl border border-primario
                 text-primario font-semibold
                 hover:bg-primario hover:text-negro
                 transition-all duration-300"
        >
          Rechazar
        </button>

        <button
          id="btn-aceptar-cookies"
          class="px-5 py-2 rounded-xl bg-primario
                 text-negro font-semibold
                 hover:bg-secundario
                 transition-all duration-300"
        >
          Aceptar
        </button>
      </div>
    </div>
  </div>
</div>

<script lang="ts" is:inline>
  const CLAVE_COOKIES = "cookies_aceptadas";

  const banner = document.getElementById(
    "cookie-banner",
  ) as HTMLDivElement | null;
  const btnAceptar = document.getElementById(
    "btn-aceptar-cookies",
  ) as HTMLButtonElement | null;
  const btnRechazar = document.getElementById(
    "btn-rechazar-cookies",
  ) as HTMLButtonElement | null;

  const mostrarBanner = (): void => {
    if (!banner) return;

    banner.classList.remove("hidden");
    banner.classList.add("animate-fade-in");
  };

  const ocultarBanner = (): void => {
    banner?.classList.add("hidden");
  };

  document.addEventListener("DOMContentLoaded", () => {
    const estado = localStorage.getItem(CLAVE_COOKIES);

    if (!estado) {
      mostrarBanner();
    }

    btnAceptar?.addEventListener("click", () => {
      localStorage.setItem(CLAVE_COOKIES, "true");
      ocultarBanner();
    });

    btnRechazar?.addEventListener("click", () => {
      localStorage.setItem(CLAVE_COOKIES, "false");
      ocultarBanner();
    });
  });
</script>
