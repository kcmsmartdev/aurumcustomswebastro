---
import Logo from "../assets/images/logo-pc.svg"
import { Image } from "astro:assets";
import { Icon } from 'astro-icon/components';
---
<footer class="w-full bg-grisClaro/60 pt-24 pb-10 px-4 font-Urbanist">

  <div class="max-w-6xl mx-auto grid gap-12 md:grid-cols-2 lg:grid-cols-4">

    <!-- Logo y descripción -->
    <div>
      <Image 
        src={Logo} 
        alt="Logo Aurum Customs SAC"
        class="w-40 h-auto"
        loading="lazy" 
      />

      <p class="mt-6 text-gris leading-relaxed">
        En Aurum Customs SAC ofrecemos soluciones de comercio exterior
        que optimizan tus operaciones internacionales con seguridad y eficiencia.
      </p>
    </div>

    <!-- Agencia -->
    <div>
      <h3 class="text-negro font-semibold text-lg">
        Agencia
      </h3>

      <ul class="mt-6 space-y-3 text-gris">
        <li><a href="/sobre-nosotros" class="hover:text-secundario transition-colors">Sobre nosotros</a></li>
        <li><a href="/tracking" class="hover:text-secundario transition-colors">Tracking</a></li>
        <li><a href="/contactanos" class="hover:text-secundario transition-colors">Contáctanos</a></li>
        <li><a href="/libro-de-reclamaciones" class="hover:text-secundario transition-colors">Libro de reclamaciones</a></li>
      </ul>
    </div>

    <!-- Servicios -->
    <div>
      <h3 class="text-negro font-semibold text-lg">
        Servicios
      </h3>

      <ul class="mt-6 space-y-3 text-gris">
        <li><a href="/servicios/agenciamiento-de-aduanas-especializado" class="hover:text-secundario transition-colors">
          Agenciamiento de aduanas
        </a></li>

        <li><a href="/servicios/especializado-asesoria-y-consultoria-en-comercio-exterior" class="hover:text-secundario transition-colors">
          Asesoría y consultoría en comercio exterior
        </a></li>

        <li><a href="/servicios/servicios-complementarios-a-su-disposicion" class="hover:text-secundario transition-colors">
          Servicios complementarios
        </a></li>
      </ul>
    </div>

    <!-- Contacto -->
    <div>
      <h3 class="text-negro font-semibold text-lg">
        Contacto
      </h3>

      <ul class="mt-6 space-y-4 text-gris">

        <li>
          <a href="tel:+51999999999" class="flex gap-3 items-center hover:text-secundario transition-colors">
            <Icon name="cuida:phone-outline" class="size-5 text-secundario" />
            +51 950 306 765
          </a>
        </li>

        <li>
          <a href="mailto:contacto@aurumcustoms.com" class="flex gap-3 items-center hover:text-secundario transition-colors">
            <Icon name="cuida:mail-outline" class="size-5 text-secundario" />
            contacto@aurumcustoms.com
          </a>
        </li>

        <li>
          <div class="flex gap-3 items-start">
            <Icon name="cuida:map-pin-outline" class="size-6 text-secundario mt-1" />
            <span>
              Av. Elmer Faucett - Tomas Valle Nro. E1 Int. 303e
            </span>
          </div>
        </li>

      </ul>
    </div>

  </div>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto mt-16 border-t border-grisClaro pt-8 flex flex-col md:flex-row justify-between gap-6 text-sm text-gris">

    <div class="flex flex-wrap gap-6">
      <a href="/terminos-y-condiciones" class="hover:text-secundario transition-colors">
        Términos y condiciones
      </a>

      <a href="/politica-de-cookies" class="hover:text-secundario transition-colors">
        Política de cookies
      </a>

      <a href="/privacidad-de-datos" class="hover:text-secundario transition-colors">
        Privacidad de datos
      </a>
    </div>

    <div>
      © {new Date().getFullYear()} Aurum Customs SAC.  
      Desarrollado por 
      <a href="https://kcmsmart.com/" target="_blank" class="font-semibold hover:text-secundario transition-colors">
        KCM Smart
      </a>
    </div>

  </div>

</footer>
