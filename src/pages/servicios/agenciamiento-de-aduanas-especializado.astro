---
import Layout from "../../layouts/Layout.astro";
import FondoCabecera from "../../assets/images/bg-section.png";
import Image from "astro/components/Image.astro";
import Servicio1 from "../../assets/images/imagen_servicio_1.png";
import FormularioContacto from "../../components/FormularioContacto.astro";
---

<Layout>
 <div class="relative w-full mt-5 min-h-67.5 overflow-hidden">
    <Image
      src={FondoCabecera}
      alt="fondo"
      class="absolute inset-0 w-full h-full object-cover object-center z-0"
    />

    <div class="absolute inset-0 bg-negro/40 z-10"></div>

    <div
      class="relative w-full max-w-6xl p-3 mx-auto flex flex-col justify-center mt-28 z-50"
    >
      <h1 class="text-28px font-bold text-blanco font-Urbanist">
        Nuestro servicio
      </h1>
      <div class="flex text-14px text-blanco">
        <a href="/">Inicio</a> &gt; <span>Nuestro servicio</span>
      </div>
    </div>
  </div>



 <section class="w-full py-24 px-4 font-Urbanist">

  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">

    <!-- Contenido -->
    <div>

      <p class="text-sm uppercase tracking-widest text-secundario font-bold">
        Servicio especializado
      </p>

      <h2 class="mt-4 text-3xl md:text-4xl font-extrabold text-negro leading-tight">
        Agenciamiento de Aduanas Especializado
      </h2>

      <div class="w-16 h-1 bg-secundario mt-6 rounded-full"></div>

      <p class="mt-8 text-gris leading-relaxed">
        Gestionamos de forma experta todos los regímenes aduaneros contemplados 
        en la Ley General de Aduanas (Decreto Legislativo N° 1053), asegurando 
        cumplimiento normativo, eficiencia operativa y optimización estratégica 
        en cada operación.
      </p>

    </div>

    <!-- Imagen -->
    <div class="relative">

      <!-- Glow decorativo -->
      <div class="absolute -inset-4 bg-secundario/10 rounded-3xl blur-2xl"></div>

      <Image
        src={Servicio1}
        alt="Agenciamiento de Aduanas Especializado"
        class="relative w-full h-[300px] md:h-[380px] object-cover rounded-3xl shadow-lg"
        loading="lazy"
      />

    </div>

  </div>

  <!-- Regímenes -->
  <div class="max-w-6xl mx-auto mt-20 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

    <article class="p-6 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
      <p class="font-semibold text-negro">
        Importación Definitiva para el Consumo
      </p>
    </article>

    <article class="p-6 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
      <p class="font-semibold text-negro">
        Exportación Definitiva
      </p>
    </article>

    <article class="p-6 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
      <p class="font-semibold text-negro">
        Regímenes Temporales (Admisión e Exportación Temporal)
      </p>
    </article>

    <article class="p-6 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
      <p class="font-semibold text-negro">
        Regímenes de Perfeccionamiento (Drawback y Admisión Temporal para Perfeccionamiento Activo)
      </p>
    </article>

    <article class="p-6 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
      <p class="font-semibold text-negro">
        Depósito Aduanero
      </p>
    </article>

    <article class="p-6 bg-white rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
      <p class="font-semibold text-negro">
        Tránsitos, Transbordos y Reembarques
      </p>
    </article>

  </div>

</section>

<section class="w-full mt-28 font-Urbanist">
    <div class="max-w-6xl mx-auto px-4 mb-16">
      <!-- Encabezado -->
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-sm uppercase tracking-widest text-secundario font-bold">
          Contáctanos
        </h2>

        <h3
          class="mt-4 text-3xl lg:text-4xl font-extrabold text-negro leading-tight"
        >
          Solicita una cotización personalizada
        </h3>
      </div>

      <!-- Grid -->
      <div class="mt-16 grid gap-12 lg:grid-cols-2 items-stretch">
        <!-- Mapa -->
        <div
          class="rounded-3xl overflow-hidden shadow-sm border border-grisClaro"
        >
          <div class="w-full h-full min-h-80 lg:min-h-full">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3902.3022599003352!2d-77.10518600000002!3d-12.022699999999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMTLCsDAxJzIxLjciUyA3N8KwMDYnMTguNyJX!5e0!3m2!1ses-419!2spe!4v1769049775517!5m2!1ses-419!2spe"
              class="w-full h-full"
              title="Ubicación de Aurum Customs SAC en Google Maps"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>

        <!-- Formulario -->
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-grisClaro">
          <FormularioContacto />
        </div>
      </div>
    </div>
  </section>


</Layout>