---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import ImagenHero from "../assets/images/imagen_fondo_hero.webp";
import ImagenSobreNosotros from "../assets/images/imagen_sobre_nosotros.webp";
import Image from "astro/components/Image.astro";
import Servicio1 from "../assets/images/imagen_servicio_1.png";
import Servicio2 from "../assets/images/imagen_servicio_2.png";
import Servicio3 from "../assets/images/imagen_servicio_3.png";
import FormularioContacto from "../components/FormularioContacto.astro";
---

<Layout>
  <main>
    <div
      class="relative min-h-[90vh] md:min-h-screen flex items-center overflow-hidden"
    >
      <!-- Imagen -->
      <Image
        src={ImagenHero}
        alt="Agencia de Aduanas en el Callao para importación y exportación"
        width={1920}
        height={1080}
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />

      <!-- Overlay profesional -->
      <div
        class="absolute inset-0 bg-linear-to-r from-negro/80 via-negro/60 to-negro/30"
      >
      </div>

      <!-- Contenido -->
      <div class="relative z-10 w-full max-w-6xl mx-auto px-4 text-blanco">
        <h1
          class="font-Urbanist font-extrabold max-w-3xl
               text-3xl sm:text-4xl md:text-5xl lg:text-6xl
               leading-tight"
        >
          Agencia de Aduanas en el Callao para Importación y Exportación
        </h1>

        <p class="mt-6 max-w-2xl text-lg font-Urbanist font-semibold text-blancoTexto">
          Especialistas en agenciamiento de aduanas, asesoría y consultoría en
          comercio exterior. Optimizamos tus operaciones logísticas con
          cumplimiento normativo y eficiencia.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl
               bg-primario text-negro font-bold font-Urbanist
               hover:bg-secundario hover:text-blanco
               transition-all duration-300"
          >
            Solicitar asesoría ahora

            <Icon
              name="ic:baseline-whatsapp"
              class="size-5 transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>

    <div
      class="w-full max-w-6xl mx-auto px-4 mt-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
    >
      <!-- Imagen -->
      <section class="flex justify-center lg:justify-start">
        <Image
          src={ImagenSobreNosotros}
          alt="Agencia de aduanas en el Callao especializada en comercio exterior"
          class="w-full max-w-md h-auto rounded-3xl border-8 border-grisClaro"
          loading="lazy"
        />
      </section>

      <!-- Texto -->
      <section class="flex flex-col gap-6 font-Urbanist">
        <h2 class="text-sm uppercase tracking-widest text-secundario font-bold">
          Sobre nosotros
        </h2>

        <h3
          class="text-3xl lg:text-4xl font-extrabold text-negro leading-tight"
        >
          Más que una agencia, somos tu socio estratégico en comercio exterior
        </h3>

        <p class="text-base font-medium text-gris leading-relaxed">
          <strong>Aurum Customs SAC</strong> es una agencia de aduanas en el Callao
          especializada en importación, exportación y comercio exterior. Brindamos
          agenciamiento de aduanas, asesoría estratégica y soluciones complementarias,
          garantizando cumplimiento SUNAT y operaciones seguras y eficientes.
        </p>
      </section>
    </div>

    <div class="w-full max-w-6xl mx-auto px-4 mt-28 font-Urbanist">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-sm uppercase tracking-widest text-secundario font-bold">
          Nuestros servicios
        </h2>

        <h3
          class="mt-4 text-3xl lg:text-4xl font-extrabold text-negro leading-tight"
        >
          Soluciones Integrales 360° en Agenciamiento de Aduanas
        </h3>
      </div>

      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Servicio 1 -->
        <article
          class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300"
        >
          <div class="overflow-hidden">
            <Image
              src={Servicio1}
              alt="Agenciamiento de aduanas especializado"
              class="w-full h-56 object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <div class="p-6 flex flex-col     ">
            <a
              href="/servicios/agenciamiento-de-aduanas-especializado"
              class="font-bold text-lg text-negro group-hover:text-secundario transition-colors duration-300"
            >
              Agenciamiento de aduanas especializado
            </a>
          </div>
        </article>

        <!-- Servicio 2 -->
        <article
          class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300"
        >
          <div class="overflow-hidden">
            <Image
              src={Servicio2}
              alt="Asesoría y Consultoría en Comercio Exterior"
              class="w-full h-56 object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <div class="p-6 flex flex-col ">
            <a
              href="/servicios/especializado-asesoria-y-consultoria-en-comercio-exterior"
              class="font-bold text-lg text-negro group-hover:text-secundario transition-colors duration-300"
            >
              Asesoría y Consultoría en Comercio Exterior
            </a>
          </div>
        </article>

        <!-- Servicio 3 -->
        <article
          class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300"
        >
          <div class="overflow-hidden">
            <Image
              src={Servicio3}
              alt="Servicios complementarios en comercio exterior"
              class="w-full h-56 object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <div class="p-6 flex flex-col">
            <a
              href="/servicios/servicios-complementarios-a-su-disposicion"
              class="font-bold text-lg text-negro group-hover:text-secundario transition-colors duration-300"
            >
              Servicios complementarios a su disposición
            </a>
          </div>
        </article>
      </div>
    </div>

    <section class="w-full mt-28 font-Urbanist">
    <div class="max-w-6xl mx-auto px-4 mb-16">
      <!-- Encabezado -->
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-sm uppercase tracking-widest text-secundario font-bold">
          Contáctanos
        </h2>

        <h3
          class="mt-4 text-3xl lg:text-4xl font-extrabold text-negro leading-tight"
        >
          Solicita una cotización personalizada
        </h3>
      </div>

      <!-- Grid -->
      <div class="mt-16 grid gap-12 lg:grid-cols-2 items-stretch">
        <!-- Mapa -->
        <div
          class="rounded-3xl overflow-hidden shadow-sm border border-grisClaro"
        >
          <div class="w-full h-full min-h-80 lg:min-h-full">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3902.3022599003352!2d-77.10518600000002!3d-12.022699999999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMTLCsDAxJzIxLjciUyA3N8KwMDYnMTguNyJX!5e0!3m2!1ses-419!2spe!4v1769049775517!5m2!1ses-419!2spe"
              class="w-full h-full"
              title="Ubicación de Aurum Customs SAC en Google Maps"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>

        <!-- Formulario -->
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-grisClaro">
          <FormularioContacto />
        </div>
      </div>
    </div>
  </section>
  </main>
</Layout>
