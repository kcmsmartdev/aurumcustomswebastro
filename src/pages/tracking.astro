---
import Layout from "../layouts/Layout.astro";
import FondoCabecera from "../assets/images/bg-section.png";
import { Image } from "astro:assets";

---

<Layout class="w-full ">
    <div class="relative w-full mt-5 min-h-67.5 overflow-hidden">
  <Image
    src={FondoCabecera}
    alt="Tracking de envíos"
    class="absolute inset-0 w-full h-full object-cover object-center z-0"
  />

  <div class="absolute inset-0 bg-negro/50 z-10"></div>

  <div
    class="relative w-full max-w-6xl p-3 mx-auto flex flex-col justify-center mt-28 z-50"
  >
    <h1 class="text-28px font-bold text-blanco font-Urbanist">
      Tracking de Envíos
    </h1>
    <div class="flex text-14px text-blanco">
      <a href="/">Inicio</a> &gt; <span>Tracking</span>
    </div>
  </div>
</div>
<section class="w-full py-24 px-4 font-Urbanist bg-grisClaro/40">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
    
    <!-- Lado Informativo -->
    <div>
      <p class="text-sm uppercase tracking-widest text-secundario font-bold">
        Plataforma segura
      </p>

      <h2 class="mt-4 text-3xl md:text-4xl font-extrabold text-negro leading-tight">
        Accede al estado de tus operaciones en tiempo real
      </h2>

      <div class="w-16 h-1 bg-secundario mt-6 rounded-full"></div>

      <p class="mt-8 text-gris leading-relaxed">
        Consulta el estado de tus embarques, documentación y movimientos 
        logísticos desde nuestra plataforma de tracking. Información 
        actualizada, segura y disponible 24/7.
      </p>

      <ul class="mt-8 space-y-3 text-gris text-sm">
        <li>✔ Seguimiento en tiempo real</li>
        <li>✔ Historial de movimientos</li>
        <li>✔ Documentación disponible</li>
        <li>✔ Plataforma segura</li>
      </ul>
    </div>

    <!-- Formulario Login -->
    <div class="relative">
      <div class="absolute -inset-4 bg-secundario/10 rounded-3xl blur-2xl"></div>

      <div class="relative bg-white p-10 rounded-3xl shadow-lg border border-gray-100">
        <h3 class="text-2xl font-bold text-negro">
          Iniciar sesión
        </h3>

        <p class="text-sm text-gris mt-2 mb-8">
          Ingresa tus credenciales para acceder al sistema.
        </p>

        <form class="space-y-6">
          <!-- Usuario -->
          <div>
            <label class="block text-sm font-medium text-negro mb-2">
              Usuario o correo electrónico
            </label>
            <input
              type="email"
              placeholder="usuario@empresa.com"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secundario focus:ring-2 focus:ring-secundario/20 outline-none transition"
            />
          </div>

          <!-- Contraseña -->
          <div>
            <label class="block text-sm font-medium text-negro mb-2">
              Contraseña
            </label>
            <input
              type="password"
              placeholder="••••••••"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-secundario focus:ring-2 focus:ring-secundario/20 outline-none transition"
            />
          </div>

          <!-- Recordar -->
          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 text-gris">
              <input type="checkbox" class="accent-secundario" />
              Recordarme
            </label>

            <a href="#" class="text-secundario hover:underline">
              ¿Olvidaste tu contraseña?
            </a>
          </div>

          <!-- Botón -->
          <button
            type="submit"
            class="w-full bg-secundario text-white py-3 rounded-xl font-semibold hover:bg-secundario/90 transition-all duration-300 shadow-md"
          >
            Acceder al Tracking
          </button>
        </form>
      </div>
    </div>

  </div>
</section>
</Layout>